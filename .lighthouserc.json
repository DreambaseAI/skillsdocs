{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3311/",
        "http://127.0.0.1:3311/a11y-fixture/clean-book",
        "http://127.0.0.1:3311/a11y-fixture/clean-book/writing-clearly"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["accessibility", "seo", "best-practices"],
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],

        "html-has-lang": "error",
        "document-title": "error",
        "meta-viewport": "error",
        "color-contrast": "error",
        "heading-order": "error",
        "landmark-one-main": "error",
        "bypass": "error",
        "link-name": "error",
        "button-name": "error",
        "aria-allowed-attr": "error",
        "aria-required-attr": "error",
        "aria-valid-attr-value": "error",
        "target-size": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "node_modules/.cache/lighthouse"
    }
  }
}
